# Relay API — all values optional for local dev (extractive Q&A needs no keys)

# Hybrid RAG: FTS + local embeddings (default on). Set false for FTS-only.
# HYBRID_SEARCH_ENABLED=true

# Optional: synthesized answers (default is extractive mode from indexed docs)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GitHub org + repo for workflow/issue links (no tokens in this app)
GITHUB_ORG=opsdevcode
GITHUB_REPO=opsdevcode/relay

# CORS
WEB_ORIGIN=http://localhost:3000
