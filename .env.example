# Portal Assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Knowledge corpus — bundled sample docs by default; override to index an external tree
KNOWLEDGE_PATH=./knowledge/corpus

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://portal:portal@postgres:5432/portal

# Redis
REDIS_URL=redis://redis:6379/0

# GitHub (org + repo for workflow links — no tokens in this app)
GITHUB_ORG=opsdevcode
GITHUB_REPO=opsdevcode/ai-developer-portal

# CORS
WEB_ORIGIN=http://localhost:3000
