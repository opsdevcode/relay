# Portal + Backstage in one `docker compose up` (optional).
# Docker Compose reads COMPOSE_PROFILES from this file when you run from repo root.
# COMPOSE_PROFILES=backstage

# Trust oauth2-proxy X-Auth-Request-* headers for retrieval ABAC (K8s / ingress only).
# USER_CONTEXT_HEADERS_ENABLED=true

# Require IdP group membership to POST /actions/confirm (see registry confirm_allowed_groups).
# CONFIRM_ACTION_AUTHORIZATION_ENABLED=true

# Sandbox ticket handoff after confirm (default github_issue — see docs/ticket-intake.md)
# TICKET_INTAKE_PROVIDER=jira
# TICKET_INTAKE_BASE_URL=https://company.atlassian.net
# TICKET_INTAKE_PROJECT=SANDBOX
# TICKET_INTAKE_USERNAME=relay-bot@company.com
# TICKET_INTAKE_API_TOKEN=...

# Audit log query (Phase 2A.4 — docs/audit-log.md)
# AUDIT_QUERY_SECRET=local-dev-audit-secret
# AUDIT_LOG_ENABLED=true

# Observability / service_health (Phase 2B.1 — docs/observability-health.md)
# OBSERVABILITY_PROVIDER=grafana_deeplink
# GRAFANA_BASE_URL=https://grafana.company.com
# GRAFANA_EMBED_PATH_TEMPLATE=/d/{dashboard_uid}?orgId=1&var-service={service}&kiosk
# PROMETHEUS_BASE_URL=https://prometheus.company.com
# PROMETHEUS_API_TOKEN=...

# GitHub catalog discovery (Phase 2C.1 — docs/catalog-discovery.md)
# GITHUB_TOKEN=...
# OPSGENIE_API_TOKEN=...

# On-call / paging (Phase 2C.3 — docs/on-call-linkage.md)
# ON_CALL_PROVIDER=deeplink
# PAGERDUTY_API_TOKEN=...
# ON_CALL_URL_TEMPLATE=https://company.pagerduty.com/schedules/{schedule_id}
