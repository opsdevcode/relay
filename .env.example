# Relay API — all values optional for local dev (extractive Q&A needs no keys)

# Hybrid RAG: FTS + local embeddings (default on). Set false for FTS-only.
# HYBRID_SEARCH_ENABLED=true

# Optional: synthesized answers (default is extractive mode from indexed docs)
# LLM_PROVIDER=none          # force extractive even if keys are set
# LLM_PROVIDER=anthropic     # default when ANTHROPIC_API_KEY is set
# LLM_PROVIDER=azure_openai
# LLM_PROVIDER=openai_compatible   # OpenAI API or Ollama (/v1/chat/completions)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=llama3

# GitHub org + repo for workflow/issue links (no tokens in this app)
GITHUB_ORG=opsdevcode
GITHUB_REPO=opsdevcode/relay

# CORS
WEB_ORIGIN=http://localhost:3000

# Corpus pipeline (see docs/corpus-pipeline.md)
# INGEST_CHECKOUT_DIR=   # default: $TMPDIR/relay-corpus-checkouts
# INGEST_WEBHOOK_SECRET=  # enables POST /internal/reindex when set
